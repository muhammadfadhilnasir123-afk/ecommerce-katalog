# ==============================================================================
# SUPABASE CONFIGURATION
# Dapatkan kredensial ini di dashboard Supabase: Project Settings -> API
# ==============================================================================

# URL Project Supabase Anda (contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anonim Publik Supabase (Anon Public Key / JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Mode Demo (opsional: bernilai 'true' jika ingin menggunakan mode katalog demo lokal tanpa Supabase)
NEXT_PUBLIC_DEMO_MODE=false
